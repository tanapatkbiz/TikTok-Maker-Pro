{
    "app_name": "TikTok Maker Pro",
    "version": "1.0.0",
    "author": "Your Name",
    "description": "แปลงวิดีโอ YouTube เป็นคลิป TikTok อัตโนมัติ",
    "default_output_folder": "~/TikTokOutput",
    "default_clip_duration": 30,
    "supported_platforms": ["windows", "macos", "linux"],
    "features": {
        "download_youtube": true,
        "split_video": true,
        "add_subtitles": true,
        "add_tts": true,
        "generate_captions": true,
        "upload_tiktok": true
    },
    "tiktok_api": {
        "enabled": false,
        "api_key_required": true,
        "documentation": "https://developers.tiktok.com/"
    }
}
